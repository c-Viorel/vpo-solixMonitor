# Anker credentials (OPTIONAL – can also be set via Admin panel in the UI)
# ANKER_EMAIL=your@email.com
# ANKER_PASSWORD=yourpassword
# ANKER_COUNTRY=us

# Flask secret key – generate a strong random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Data collection interval in seconds (default: 300 = 5 min)
# POLL_INTERVAL=300

# Port for the development server (default: 8080; port 5000 is used by macOS AirPlay)
# PORT=8080

# Set to true only during local development
# DEBUG=false
